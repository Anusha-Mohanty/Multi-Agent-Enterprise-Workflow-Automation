# Leave ANTHROPIC_API_KEY empty to run with the deterministic rule-based planner/analyst.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
DB_PATH=workflow.db
# local = call tools in-process | stdio = call them through a real MCP server subprocess
MCP_TRANSPORT=local
AUTO_APPROVE_LIMIT=50000
MAX_EXEC_ATTEMPTS=3
